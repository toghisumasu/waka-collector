<h1>連歌 — 前句を入力</h1>

<% if flash[:alert] %>
  <p style="color:#b00"><%= flash[:alert] %></p>
<% end %>

<% if @warning %>
  <p style="color:#c60"><strong><%= @warning %></strong></p>
<% end %>

<%# フォーム送信は通常のHTTPナビゲーションにする（data-turbo=false）。
    Turbo Drive はフォームPOSTへの 200 レンダリング（create の字余り確認画面）を
    描画しないため、確認フローが壊れる。結果画面のライブ更新は show 側の
    turbo_stream_from（Action Cable）が担うので、ここで Turbo を切っても影響しない。 %>
<%= form_with model: @renga, data: { turbo: false } do |f| %>
  <%= f.hidden_field :previous_renga_id %>
  <div>
    <%= f.label :maeku, "前句（五七五）" %><br>
    <%= f.text_area :maeku,
          placeholder: "春はあけぼの やうやう白く なりゆく山ぎは" %>
  </div>

  <fieldset>
    <legend>本歌参照候補</legend>
    <% @honkas.each do |honka| %>
      <label>
        <%= check_box_tag "renga[honka_ids][]", honka.id %>
        <%= honka.upper_phrase_text.to_s + honka.lower_phrase_text.to_s + "（" + honka.author.to_s + "）" %>
      </label><br>
    <% end %>
  </fieldset>

  <% if @confirmed %>
    <%= hidden_field_tag :confirmed, "true" %>
    <%= f.submit "字余りのまま続ける" %>
  <% else %>
    <%= f.submit "付け句を生成する" %>
  <% end %>
<% end %>

<% if @confirmed %>
  <%# 「差し戻す」は生成エンドポイント（form_with = create）を経由させず、
      前句再入力画面（new）へ素のGETで戻す。_result.html.erbの
      「前句の入力からやり直す」と同じパターン。 %>
  <p><%= link_to "差し戻す", new_renga_path(previous_renga_id: @renga.previous_renga_id) %></p>
<% end %>
