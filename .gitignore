# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
# S-0: 再生成できない実データ（seed未固定の採点rawと、手ラベルの盲検シート）は追跡する
!/tmp/minase_qwen8b_score_raw.csv
!/tmp/minase_label_sheet.csv
# S-0b: 軸別呼び出しの採点raw（同上の理由で追跡。summaryは再生成できるので追跡しない）
!/tmp/minase_qwen8b_split_raw.csv
# S-0c: 軸別×結論先出し・理由後置の採点raw（同上の理由で追跡）
!/tmp/minase_qwen8b_split_reason_raw.csv

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key
/vendor/bundle
/config/database.yml
*:Zone.Identifier
db/wakas_backup.sql
app/controllers/*.swp
.DS_Store
Create_*.py
*.bak
patch_*.py

# 著作物PDF（研究紀要）はローカル参照のみ、コミット対象外
docs/reference/*.pdf
docs/kiyo_r2_7.pdf
docs/kiyo_r3_5.pdf

# UniDic和歌版（CC BY-NC-SA 4.0、非営利限定・容量大）はリポジトリに同梱しない（其の六十九）
# 通常配置はリポジトリ外またはtmp/配下（/tmp/*で既存カバー済み）。
# dict/配下に置く運用も想定した予防的除外。
dict/unidic-waka*
dict/unidic_user_entries.csv
dict/unidic_user.dic
