<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 雛形のみ。配置と launchctl load はユーザーが行う。トークンは書かない（環境ファイルのパスだけ）。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.label-bot.poll</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABS/PATH/TO/ruby</string>
    <string>/Volumes/externalHDD/projects/waka-collector/script/label_bot/poll.rb</string>
  </array>
  <key>WorkingDirectory</key><string>/Volumes/externalHDD/projects/waka-collector</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LABEL_BOT_ENV_FILE</key><string>/Users/YOUR_USER/.config/label_bot/env</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/YOUR_USER/Library/Logs/label_bot_poll.log</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USER/Library/Logs/label_bot_poll.log</string>
</dict>
</plist>
